{
  "name": "redis-visualizer-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:compile": "tsc -p electron/tsconfig.json && node electron/postbuild.mjs",
    "electron:dev": "pnpm electron:compile && node electron/dev.mjs",
    "electron:build": "pnpm build && pnpm electron:compile && electron-builder",
    "electron:build:win": "pnpm build && pnpm electron:compile && electron-builder --win",
    "electron:build:mac": "pnpm build && pnpm electron:compile && electron-builder --mac",
    "electron:build:linux": "pnpm build && pnpm electron:compile && electron-builder --linux"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.20.0",
    "echarts": "^5.6.0",
    "element-plus": "^2.14.6",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.12"
  }
}
